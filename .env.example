# Copy this file to .env.local for local dev, and add the same
# variables in Vercel: Project Settings -> Environment Variables.
# Get the values from your Supabase dashboard (Settings -> API).

# Supabase project URL, e.g. https://xxxx.supabase.co
VITE_SUPABASE_URL=

# Publishable (anon) key - safe for the browser
# Supabase automatically maps both VITE_SUPABASE_ANON_KEY and
# VITE_SUPABASE_PUBLISHABLE_KEY — the latter is preferred for new projects.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Traditional anon key — also supported; if unspecified, the
# publishable key is used as fallback. Do NOT add the service-role
# key here — it is server-side only.
VITE_SUPABASE_ANON_KEY=

# NEVER put the service role key in this file - it is server-side only.
